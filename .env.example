# Skopiuj do .env i uzupełnij. .env jest w .gitignore — nie commituj go.
# Tylko nazwy zmiennych czytanych przez kod (FSA #0 F-11) — bez wartości.

# Klucz The Odds API (plan darmowy: 500 kredytów/mies.).
# Rejestracja: https://the-odds-api.com/
# UWAGA: klucz idzie w parametrze URL `apiKey`, więc trafia do logów i do
# zapisanych URL-i, jeśli się go nie zredaguje. Robi to `net/http.py`
# i `ingest/odds_api.py`. Budżet 450/mies. jest stałą w kodzie
# (`odds_api.MONTHLY_BUDGET`), nie zmienną środowiska.
VB_ODDS_API_KEY=

# Liga domyślna klienta (klucz z /v4/sports). Kolektor ma własną listę lig.
VB_ODDS_SPORT=soccer_poland_ekstraklasa

# Telegram — przegląd dnia (`live/digest.py`). Puste = digest do pliku
# `reports/digest/`. Token idzie w ścieżce URL (/bot<token>/), klient go redaguje.
VB_TELEGRAM_TOKEN=
VB_TELEGRAM_CHAT_ID=
